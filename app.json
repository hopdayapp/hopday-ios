{
  "expo": {
    "name": "Hopday",
    "slug": "hopday",
    "scheme": "hopday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#14213D",
    "ios": {
      "bundleIdentifier": "com.uniformsudc.hopday",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "WKAppBoundDomains": [
          "hopday.app",
          "www.hopday.app",
          "trips.uniforms-udc.com",
          "yonkisqhwyquydvjjwqq.supabase.co"
        ],
        "NSLocationWhenInUseUsageDescription": "Hopday uses your location to check you in at the places on your plan and to show how long it takes to get to the next stop.",
        "NSCameraUsageDescription": "Hopday uses the camera so you can photograph a ticket or booking and add it to your trip.",
        "NSPhotoLibraryUsageDescription": "Hopday opens your photos so you can add screenshots of bookings and tickets to your trip.",
        "NSMicrophoneUsageDescription": "Hopday uses the microphone when you ask the trip assistant something by voice.",
        "NSSpeechRecognitionUsageDescription": "Hopday turns what you say into text when you ask the trip assistant by voice.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.uniformsudc.hopday",
      "adaptiveIcon": {
        "backgroundColor": "#14213D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Hopday reads your step count to show how far you walked on each day of your trip.",
          "NSHealthUpdateUsageDescription": "Hopday never writes to Apple Health. It only reads your step count to show how far you walked on each day of your trip.",
          "background": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#14213D"
        }
      ],
      "expo-build-properties",
      "expo-sharing",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.uniformsudc.hopday",
          "widgets": [
            {
              "name": "HopdayToday",
              "displayName": "Hopday today",
              "description": "Where you are, time left and your next stop.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline",
                  "accessoryCircular"
                ],
                "initialLayout": "./widgets/HopdayWidgets.tsx"
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "owner": "hopday",
    "extra": {
      "eas": {
        "projectId": "dccfb5a7-3585-4b63-8c9c-571e5645fd14"
      }
    }
  }
}